# Copy to web/.env.local (gitignored) and fill in ONE provider. Restart `npm run dev` after editing.
# With nothing set, the agent still answers using the built-in graph explainer (no LLM, no key).

# groq | ollama | anthropic | none   (default: first one that is configured)
LLM_PROVIDER=

# Groq free plan (no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local, free, offline): install from ollama.com, then `ollama pull qwen3:4b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Claude (paid, best quality; full multi-step tool agent)
ANTHROPIC_API_KEY=
