# Copy to web/.env.local (gitignored) and fill in ONE provider. Restart `npm run dev` after editing.
# With nothing set, brains still answer graph-only (a summary of their closest beliefs; no LLM, no key).

# groq | ollama | none   (default: the first one that is configured)
LLM_PROVIDER=

# Groq free plan (no card): https://console.groq.com/keys
GROQ_API_KEY=
# main model, and the model used automatically when its daily free quota is used up
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Ollama (local, free, offline): install from ollama.com, then `ollama pull qwen3:4b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

